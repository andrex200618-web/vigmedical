# Copia este archivo como .env.local y completa los valores reales.
# Nunca uses NEXT_PUBLIC_ para SUPABASE_SERVICE_ROLE_KEY.

SUPABASE_URL=https://tu-proyecto-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key-privada
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-publica
RATE_LIMIT_SECRET=genera-un-secreto-aleatorio-de-al-menos-32-caracteres

# Cloudflare Turnstile. Ambos valores son obligatorios en producción.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=tu-site-key-publica
TURNSTILE_SECRET_KEY=tu-secret-key-privada
